include ../mixins/_starRating

mixin reviewCard(name, comment, rating, date = null, isOwner = false, equipmentUuid = null, reviewUuid = null)
  .card.shadow-sm.border-0.mb-3
    .card-body
      .d-flex.justify-content-between.align-items-center.mb-2
        .d-flex.align-items-center.gap-2
          i.fa-solid.fa-user.text-secondary.fs-5
          h6.mb-0.fw-semibold= name
        if date
          small.text-muted= new Date(date).toLocaleDateString('ca-ES', { year: 'numeric', month: 'short', day: 'numeric' })

      +starRating(0, rating, false)

      if !isOwner
        if comment
          p.mt-2.mb-0.fs-6.text-body= comment
        else
          p.mt-2.mb-0.text-muted.em.small (Sense comentari)
      else
        .review-content.mt-2
          p.fs-6.text-body.mb-1= comment
          button.btn.btn-sm.btn-outline-secondary.edit-review-btn(
            type="button"
            data-bs-toggle="collapse"
            data-bs-target=`#edit-review-${reviewUuid}`
          )
            i.fa-solid.fa-pen.me-1
            | Editar

        .collapse.mt-3(id=`edit-review-${reviewUuid}`)
          form(action=`/equipment/${equipmentUuid}/review/${reviewUuid}/update` method="POST")
            .mb-2
              +starRating(rating, 0, true)
            .mb-2
              label.form-label Comentari
              textarea.form-control(name="comment" rows="2")= comment
            button.btn.btn-sm.btn-primary(type="submit")
              i.fa-solid.fa-floppy-disk.me-1
              | Desa
