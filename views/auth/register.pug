extends ../layout

block content
  .container.mt-4
    h2.mb-4 #{title}

    form(action='/register' method='POST')
      .mb-3
        label(for="name" class="form-label") Nombre
        input.form-control(type="text" name="name" value=(body && body.name) ? body.name : '' required)
        if errors && errors.name
          small.text-danger #{errors.name.msg}

      .mb-3
        label(for="email" class="form-label") Email
        input.form-control(type="email" name="email" value=(body && body.email) ? body.email : '' required)
        if errors && errors.email
          small.text-danger #{errors.email.msg}

      .mb-3
        label(for="password" class="form-label") Contraseña
        input.form-control(type="password" name="password")
        if errors && errors.password
          small.text-danger #{errors.password.msg}

      .mb-3
        label(for="password-confirm" class="form-label") Confirmar contraseña
        input.form-control(type="password" name="password-confirm")
        if errors && errors['password-confirm']
          small.text-danger #{errors['password-confirm'].msg}

      button.btn.btn-primary(type="submit") Registrarse
