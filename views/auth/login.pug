extends ../layout

block content
  .container.mt-4
    h2.mb-4 #{title}

    form(action='/auth/login' method='POST')
      .mb-3
        label(for="email" class="form-label") Email
        input.form-control(type="email" name="email" value=(body && body.email) ? body.email : '' required)
        if errors && errors.email
          small.text-danger #{errors.email.msg}

      .mb-3
        label(for="password" class="form-label") Passoword
        input.form-control(type="password" name="password" required)
        if errors && errors.password
          small.text-danger #{errors.password.msg}

      button.btn.btn-primary(type="submit") Login
