mixin authForm(title, action, type, body = {})
  .container.mt-5
    .row.justify-content-center
      .col-md-6.col-lg-5
        .card.shadow-sm.border-0
          .card-body.p-4
            h2.mb-4.text-center #{title}

            form(action=action method='POST')
              if type === 'register'
                .mb-3
                  label.form-label(for="name") Nom
                  input.form-control(
                    type="text"
                    name="name"
                    id="name"
                    value=body.name || ''
                    required
                  )

              .mb-3
                label.form-label(for="email") Correu electrònic
                input.form-control(
                  type="email"
                  name="email"
                  id="email"
                  value=body.email || ''
                  required
                )

              .mb-3
                label.form-label(for="password") Contrasenya
                input.form-control(
                  type="password"
                  name="password"
                  id="password"
                  required
                )

              if type === 'register'
                .mb-3
                  label.form-label(for="password-confirm") Confirma la contrasenya
                  input.form-control(
                    type="password"
                    name="password-confirm"
                    id="password-confirm"
                    required
                  )

              button.btn.btn-primary.w-100.mt-3(type="submit")
                if type === 'register'
                  | Crear compte
                else
                  | Iniciar sessió
