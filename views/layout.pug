doctype html
html
  head
    title #{title}
    link(rel='stylesheet' href='/css/style.css')
    link(rel='stylesheet' href='/css/bootstrap.min.css')
    link(rel="stylesheet" href="/icons/fontawesome-7.1.0/css/fontawesome.min.css")
    link(rel='icon' href='data:;base64,iVBORw0KGgo=')
    meta(name="viewport" content="width=device-width, initial-scale=1")
  body
    block header
      nav.navbar.navbar-expand-sm.bg-body-tertiary(data-bs-theme="dark")
        div.container-fluid
          a.navbar-brand(href='#')
            img(src="/icons/logo.svg" alt="" width="140" height="40" title="Bootstrap")
          button.navbar-toggler(type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation")
            span.navbar-toggler-icon
          .collapse.navbar-collapse#navbarNav
            ul.navbar-nav
              each item in menu
                li.nav-item
                  a.nav-link(href=`#`)
                    span #{item.title}

            .form-inline
              input.form-control.mr-sm-2(type="text" placeholder="Coffee, beer..." name="search")
              .search__results

            ul.navbar-nav.ms-auto
              if user
                li.nav-item
                  a.nav-link
                    i.fa.fa-user-circle(style="padding-right:5px")
                    span #{user.name}
                li.nav-item
                  a.nav-link(href='/auth/logout')
                    i.fa.fa-sign-out(style="padding-right:5px")
                    |Log Out
              else
                li.nav-item
                  a.nav-link(href='/auth/register')
                    i.fa.fa-user(style="padding-right:5px")
                    |Sign Up
                li.nav-item
                  a.nav-link(href='/auth/login')
                    i.fa.fa-sign-in(style="padding-right:5px")
                    |Login

    .content
      block content

      include mixins/_flashNotifications
      +flashNotifications(messages)

    block scripts
      script(src="/dist/bootstrap.bundle.min.js")
      script(src="/dist/app.bundle.js")
