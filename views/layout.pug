include mixins/_flashNotifications

doctype html
html
  head
    title #{title}
    link(rel='stylesheet' href='/css/bootstrap.min.css')
    link(rel="stylesheet" href="/icons/fontawesome-7.1.0/css/fontawesome.min.css")
    link(rel='stylesheet' href='/css/style.css')
    link(rel='icon' href='data:;base64,iVBORw0KGgo=')
    meta(name="viewport" content="width=device-width, initial-scale=1")
  body.bg-light.d-flex.flex-column.min-vh-100
    block header
      nav.navbar.navbar-expand-sm.navbar-dark.bg-dark.shadow-sm
        .container-fluid
          a.navbar-brand(href='/')
            i.bi.bi-buildings-fill.me-2
            | Equipaments

          button.navbar-toggler(type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation")
            span.navbar-toggler-icon

          .collapse.navbar-collapse#navbarNav
            ul.navbar-nav.me-auto
              each item in menu
                li.nav-item
                  a.nav-link(href=item.slug) #{item.title}

            ul.navbar-nav.ms-sm-3
              if user
                li.nav-item.dropdown
                  a.nav-link.dropdown-toggle(href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false")
                    i.bi.bi-person-circle.me-1
                    | #{user.name}
                  ul.dropdown-menu.dropdown-menu-end
                    li
                      a.dropdown-item(href="/user/reviews/ranking") El meu ranking
                    li
                      a.dropdown-item(href="/user/reviews") Les meves reviews
                    li
                      hr.dropdown-divider
                    li
                      a.dropdown-item(href='/auth/logout')
                        i.bi.bi-box-arrow-right.me-2
                        | Tanca Sessió
              else
                li.nav-item
                  a.nav-link(href='/auth/register')
                    i.bi.bi-person-plus.me-1
                    | Registra't
                li.nav-item
                  a.nav-link(href='/auth/login')
                    i.bi.bi-box-arrow-in-right.me-1
                    | Inicia Sessió

    main.container.my-4.flex-fill
      +flashNotifications(messages)

      block content

    footer.bg-dark.text-white.text-center.p-3.mt-5
      p &copy; #{new Date().getFullYear()} - Equipaments

    block scripts
      if equipment
        - const { reviews, ...safeEquipment } = equipment
        script.
          window.equipments = !{JSON.stringify([safeEquipment] || [])};
      if equipments
        script.
          window.equipments = !{JSON.stringify(equipments|| [])};

      script(src="/dist/bootstrap.bundle.min.js")
      script(src="/dist/app.bundle.js")

