extends layout

block content
  .container
    .card.shadow-sm.border-0
      .card-body.p-4.p-md-5
        h1.display-6.fw-bold.mb-4
          i.bi.bi-plus-circle.me-2
          | Nou Equipament

        p.text-muted.mb-4 Omple el formulari per crear un nou equipament.

        - const formAction = "/equipment/new"
        - const submitLabel = "Desar equipament"
        - const cancelHref = "/"
        include equipment/form

block append scripts
  include equipment/form-script
