extends layout

block content
  .d-flex.justify-content-between.align-items-center.mb-3
    h1.display-5 Equipaments
    
    //- Botó de filtre per tipus (com demanaves)
    .dropdown
      button.btn.btn-outline-primary.dropdown-toggle(type="button" data-bs-toggle="dropdown" aria-expanded="false")
        i.bi.bi-filter.me-1
        | Filtra per Tipus
      ul.dropdown-menu.dropdown-menu-end
        li
          a.dropdown-item(href="/") Tots
        //- Hauràs de passar una variable 'tipusUnics' (un array de strings) des del teu controlador
        if tipusUnics
          each tipus in tipusUnics
            li
              //- Això filtrarà per query string, ex: /equipaments?tipus=Biblioteca
              a.dropdown-item(href=`/?${tipus}`)= tipus

  //- Graella responsiva
  //- 1 columna en mòbil (default), 2 en tauleta (md), 3 en escriptori (lg)
  .row.row-cols-1.row-cols-md-2.row-cols-lg-3.g-4
    if equipments && equipments.length > 0
      each equipment in equipments
        //- Cridem al mixin de la targeta
        +equipmentCard(equipment)
    else
      .col-12
        .alert.alert-info No s'han trobat equipaments.
