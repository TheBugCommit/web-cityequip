extends layout

block content
  .d-flex.justify-content-between.align-items-center.mb-3
    h1.display-5 Equipaments
    
    .dropdown
      button.btn.btn-outline-primary.dropdown-toggle(type="button" data-bs-toggle="dropdown" aria-expanded="false")
        i.bi.bi-filter.me-1
        | #{currentType ? currentType : 'Filtra per tipus'}
      ul.dropdown-menu.dropdown-menu-end
        li
          a.dropdown-item(href="/") Tots
        if unicTypes 
          each type in unicTypes 
            li
              a.dropdown-item(
                href=`/filter/${type}`
                class=(selectedType === type ? 'active' : '')
              )= type

  .row.row-cols-1.row-cols-md-2.row-cols-lg-3.g-4
    if equipments && equipments.length > 0
      each equipment in equipments
        +equipmentCard(equipment)
    else
      .col-12
        .alert.alert-info No s'han trobat equipaments.
