mixin equipmentCard(equipment)
  .col
    .card.h-100.shadow-sm.equipment-card.border-0
      a.card-body.text-decoration-none.d-flex.flex-column(href=`/equipment/${equipment.uuid}`)
        h5.card-title.text-dark.fw-bold
          | #{equipment.nom}
        
        h6.card-subtitle.mb-2
          span.badge.bg-secondary.fw-normal= equipment.tipus
        
        p.card-text.text-muted.mb-1
          i.bi.bi-geo-alt-fill.me-2
          | #{equipment.localitzacio}
        p.card-text.text-muted
          i.bi.bi-pin-map.me-2
          | Districte: #{equipment.districte}

        +starRating(0, equipment.avgRating || 0, false)
        
        .mt-auto.text-end
          span.text-primary.fw-bold Veure Detalls 
            i.bi.bi-arrow-right-short

mixin rankingCard(entry)
  - const detailUrl = entry.url || (entry.equipmentUuid ? `/equipment/${entry.equipmentUuid}` : '#')
  .col
    .card.h-100.shadow-sm.ranking-card.border-0
      a.card-body.text-decoration-none.d-flex.flex-column.gap-3.h-100.text-dark(href=detailUrl)
        .d-flex.align-items-center.justify-content-between
          .d-flex.align-items-center.gap-3
            span.badge.bg-primary.rounded-pill.px-3.py-2.fs-6 #{entry.position}
            .d-flex.flex-column
              h5.card-title.text-dark.fw-bold.mb-1= entry.name
          span.badge.bg-secondary #{entry.reviewsCount} ressenya(s)
        if entry.avgRating !== null
          .mt-auto.text-end
            +starRating(entry.avgRating)
            if entry.avgRatingDisplay
              small.text-muted.d-block.mt-2 #{entry.avgRatingDisplay} / 5
        else
          .mt-auto
            small.text-muted Sense puntuacions disponibles

mixin starRating(rating = 0, avgRating = 0, interactive = false)
  if interactive
    label.form-label(for="rating") Puntuació
      .star-rating
        each i in [1, 2, 3, 4, 5]
          i.fa-star.fa-regular.star(data-value=i)
        input(type="hidden" name="rating" value=rating)
  else
    - const fullStars = Math.floor(avgRating)
    - const remainder = avgRating - fullStars
    - const partialPercent = Math.round(remainder * 100)
    - const emptyStars = 5 - fullStars - (partialPercent > 0 ? 1 : 0)

    .star-rating.readonly
      each i in [...Array(fullStars).keys()]
        i.fa-solid.fa-star.filled

      if partialPercent > 0
        i.fa-regular.fa-star
          i.fa-solid.fa-star.star-partial(class=`star-partial-${partialPercent}`)

      each i in [...Array(emptyStars).keys()]
        i.fa-regular.fa-star

    if avgRating
      span.ms-2.text-muted #{avgRating.toFixed(1)}

mixin equipmentDetail(equipment)
  .card.shadow-sm.border-0
    .card-body.p-4.p-md-5
      .row.g-4
        .col-lg-7
          h1.display-6.fw-bold.mb-3
            | #{equipment.nom}
          
          ul.list-unstyled.fs-5
            li.mb-2
              span.badge.bg-primary.fs-6= equipment.tipus
            li.mb-2
              strong.d-inline-block.me-2(style="min-width: 100px;") Adreça: 
              | #{equipment.localitzacio}
            li.mb-2
              strong.d-inline-block.me-2(style="min-width: 100px;") Districte:
              | #{equipment.districte}
            if equipment.horari
              li.mb-2
                strong.d-inline-block.me-2(style="min-width: 100px;") Horari:
                | #{equipment.horari}
            if equipment.telefon
              li.mb-2
                strong.d-inline-block.me-2(style="min-width: 100px;") Telèfon:
                a(href=`tel:${equipment.telefon}`)= equipment.telefon
            li.mb-2
              strong.d-inline-block.me-2(style="min-width: 100px;") Entitat:
              | #{equipment.nom_ens}
            li.mb-2
              strong.d-inline-block.me-2(style="min-width: 100px;") Municipal:
              if equipment.municipal
                span.badge.bg-success Sí
              else
                span.badge.bg-danger No

        //- Columna del mapa (placeholder)
        .col-lg-5
          h4.text-muted.mb-3 Localització
          //- Aquí és on aniria un mapa de Leaflet, Google Maps, etc.
          //- Utilitzant equipment.latitud i equipment.longitud
          #map.bg-secondary.bg-opacity-10.rounded.border(style="height: 300px; display: flex; align-items: center; justify-content: center; color: #6c757d;")
            .text-center
              i.bi.bi-map.fs-1
              p (Aquí aniria el mapa)
