- const eq = typeof equipment !== 'undefined' && equipment ? equipment : {}
- const address = typeof addressParts !== 'undefined' && addressParts ? addressParts : {}
- const prefixValue = address.prefix || ''
- const streetValue = address.street || ''
- const numberValue = address.number || ''
- const blockValue = address.block || ''
- const staircaseValue = address.staircase || ''
- const floorValue = address.floor || ''
- const doorValue = address.door || ''
- const postalCodeValue = address.postalCode || ''
- const prefixOptions = ['RB','CR','AV','PG','PL','CM','AC','CT','PE','ML','CL','BL','PR','PJ','DM','C','PZ','PS']
- const actionUrl = typeof formAction !== 'undefined' ? formAction : '/equipment/new'
- const submitText = typeof submitLabel !== 'undefined' ? submitLabel : 'Desar equipament'
- const cancelUrl = typeof cancelHref !== 'undefined' ? cancelHref : '/'
- let municipalValue = ''
- if (typeof eq.municipal === 'string') {
-   const normalizedMunicipal = eq.municipal.toLowerCase()
-   if (normalizedMunicipal === 'true' || normalizedMunicipal === '1') {
-     municipalValue = 'si'
-   } else if (normalizedMunicipal === 'false' || normalizedMunicipal === '0') {
-     municipalValue = 'no'
-   } else {
-     municipalValue = normalizedMunicipal
-   }
- } else if (typeof eq.municipal === 'boolean') {
-   municipalValue = eq.municipal ? 'si' : 'no'
- }
- if (municipalValue !== 'si' && municipalValue !== 'no') {
-   municipalValue = ''
- }
- const telefonValue = (typeof eq.telefon !== 'undefined' && eq.telefon !== null) ? String(eq.telefon) : ''
- const codiEnsValue = (typeof eq.codi_ens !== 'undefined' && eq.codi_ens !== null) ? String(eq.codi_ens) : ''
- const latitudValue = (typeof eq.latitud !== 'undefined' && eq.latitud !== null) ? eq.latitud : ''
- const longitudValue = (typeof eq.longitud !== 'undefined' && eq.longitud !== null) ? eq.longitud : ''

form#equipment-form(action=actionUrl method="POST")
  input#localitzacioHidden(type="hidden" name="localitzacio" value=eq.localitzacio || '')
  .row.g-3
    .col-md-6
      label.form-label(for="nom") Nom *
      input#nom.form-control(type="text" name="nom" required placeholder="Nom de l'equipament" value=eq.nom || '')
    .col-md-6
      label.form-label(for="tipus") Tipus
      input#tipus.form-control(type="text" name="tipus" placeholder="Biblioteca, Esportiu..." value=eq.tipus || '')
    .col-md-3
      label.form-label(for="localitzacio-prefix") Tipus de via
      select#localitzacio-prefix.form-select(name="address[prefix]")
        option(value="" selected=prefixValue === '') Sense prefix
        each optionPrefix in prefixOptions
          option(value=optionPrefix selected=prefixValue === optionPrefix)= optionPrefix
    .col-md-6
      label.form-label(for="localitzacio-nom") Nom del carrer *
      input#localitzacio-nom.form-control(type="text" name="address[street]" required placeholder="Diagonal" value=streetValue)
    .col-md-3
      label.form-label(for="localitzacio-numero") Numero
      input#localitzacio-numero.form-control(type="text" name="address[number]" placeholder="123 o S/N" value=numberValue)
      small.form-text.text-muted Accepta números, rangs (ex. 7-9) o S/N
    .col-md-3
      label.form-label(for="localitzacio-blq") Bloc (opcional)
      input#localitzacio-blq.form-control(type="text" name="address[block]" placeholder="ex. D" value=blockValue maxlength="30")
      small.form-text.text-muted Pots indicar text o números (ex. Sant Tadeu)
    .col-md-3
      label.form-label(for="localitzacio-esc") Escala (opcional)
      input#localitzacio-esc.form-control(type="text" name="address[staircase]" placeholder="ex. 1" value=staircaseValue maxlength="30")
      small.form-text.text-muted Opcional
    .col-md-3
      label.form-label(for="localitzacio-plnt") Planta (opcional)
      input#localitzacio-plnt.form-control(type="text" name="address[floor]" placeholder="ex. 3, BAIXOS, -1" value=floorValue maxlength="30")
      small.form-text.text-muted Pots indicar plantes especials (BAIXOS, -1, etc.)
    .col-md-3
      label.form-label(for="localitzacio-prt") Porta (opcional)
      input#localitzacio-prt.form-control(type="text" name="address[door]" placeholder="ex. 2A" value=doorValue maxlength="30")
      small.form-text.text-muted Opcional
    .col-md-6
      label.form-label(for="localitzacio-cp") Codi Postal *
      input#localitzacio-cp.form-control(type="text" name="address[postalCode]" required maxlength="5" pattern="\\d{5}" inputmode="numeric" placeholder="08019" value=postalCodeValue)
      small.form-text.text-muted Format: 5 digits
    .col-md-6
      label.form-label(for="districte") Districte
      input#districte.form-control(type="text" name="districte" placeholder="Districte" value=eq.districte || '')
    .col-md-6
      label.form-label(for="telefon") Telefon
      input#telefon.form-control(type="tel" name="telefon" placeholder="612345678" pattern="\\d{9}" inputmode="numeric" value=telefonValue)
      small.form-text.text-muted Format: 9 digits sense espais
    .col-md-6
      label.form-label(for="horari") Horari
      input#horari.form-control(type="text" name="horari" placeholder="Horari d'obertura" value=eq.horari || '')
    .col-md-6
      label.form-label(for="nom_ens") Entitat *
      input#nom_ens.form-control(type="text" name="nom_ens" required placeholder="Entitat responsable" value=eq.nom_ens || '')
    .col-md-6
      label.form-label(for="codi_ens") Codi ens
      input#codi_ens.form-control(type="text" name="codi_ens" placeholder="1234567890" pattern="\\d{10}" inputmode="numeric" value=codiEnsValue)
      small.form-text.text-muted Format: 10 digits
    .col-md-6
      label.form-label(for="latitud") Latitud
      input#latitud.form-control(type="number" name="latitud" step="0.000001" min="-90" max="90" placeholder="41.118700" value=latitudValue)
    .col-md-6
      label.form-label(for="longitud") Longitud
      input#longitud.form-control(type="number" name="longitud" step="0.000001" min="-180" max="180" placeholder="1.244500" value=longitudValue)
    .col-md-6
      label.form-label(for="municipal") Es municipal?
      select#municipal.form-select(name="municipal")
        option(value="" selected=municipalValue === '') Selecciona una opcio
        option(value="si" selected=municipalValue === 'si') Si
        option(value="no" selected=municipalValue === 'no') No
  .mt-4.d-flex.align-items-center
    button.btn.btn-primary.me-2(type="submit")
      i.bi.bi-save.me-1
      | #{submitText}
    a.btn.btn-secondary(href=cancelUrl)
      i.bi.bi-x-circle.me-1
      | Cancelar
