extends ../layout
include ../reviews/_reviewCard
include ../mixins/_starRating
include _detail

block content
  +equipmentDetail(equipment)

  if user && user.role === 'admin'
    .mt-4
      a.btn.btn-warning.me-2(href=paths.equipment.edit(equipment.uuid))
        i.fa-solid.fa-pencil.me-1
        | Editar
      a.btn.btn-danger.confirmation(href=paths.equipment.delete(equipment.uuid))
        i.fa-solid.fa-trash.me-1
        | Eliminar

  .mt-5
  h2.display-6 Ressenyes

  if user
    .card.shadow-sm.my-4.border-0
      .card-body
        h5.card-title.mb-4 Deixa la teva opinió
        form#review-form(action=paths.equipment.review_create(equipment.uuid) method="POST")
          .mb-3
            +starRating(0, 0, true)
          .mb-3
            label.form-label(for="comment") Comentari
            textarea.form-control(id="comment" name="comment" rows="3" placeholder="Escriu la teva opinió...")

          button.btn.btn-primary(type="submit") Envia Ressenya
  else
    .alert.alert-secondary.my-4
      a(href=paths.auth.login) Inicia sessió
      |  per deixar una ressenya.

  .list-group.shadow-sm
      .list-group-item.py-3
        if Array.isArray(equipment.reviews) && equipment.reviews.length > 0
          each review in equipment.reviews
            +reviewCard(
              review.user.name, 
              review.comment, 
              review.rating,
              review.updatedAt,
              user && user._id.toString() === review.user._id.toString(),
              equipment.uuid,
              review.uuid
            )
        else
          .list-group-item
            p.text-muted No hi ha ressenyes.