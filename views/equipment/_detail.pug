mixin equipmentDetail(equipment)
  .card.shadow-sm.border-0
    .card-body.p-4.p-md-5
      .row.g-4
        .col-lg-7
          h1.display-6.fw-bold.mb-3
            | #{equipment.nom}
          
          ul.list-unstyled.fs-5
            li.mb-2.d-flex.align-items-center
              strong.me-2.text-nowrap Adreça:
              span.flex-grow-1 #{equipment.localitzacio}
            li.mb-2.d-flex.align-items-center
              strong.me-2.text-nowrap Districte:
              span.flex-grow-1 #{equipment.districte}
            if equipment.horari
              li.mb-2.d-flex.align-items-center
                strong.me-2.text-nowrap Horari:
                span.flex-grow-1 #{equipment.horari}
            if equipment.telefon
              li.mb-2.d-flex.align-items-center
                strong.me-2.text-nowrap Telèfon:
                a(href=`tel:${equipment.telefon}`)= equipment.telefon
            li.mb-2.d-flex.align-items-center
              strong.me-2.text-nowrap Entitat:
              span.flex-grow-1 #{equipment.nom_ens}
            li.mb-2.d-flex.align-items-center
              strong.me-2.text-nowrap Municipal:
              if equipment.municipal
                span.badge.bg-success Sí
              else
                span.badge.bg-danger No
            li.mb-2.d-flex.align-items-center
              strong.me-2.text-nowrap Puntuació:
              +starRating(0, equipment.avgRating || 0, false)

        .col-lg-5
          h4.text-muted.mb-3 Localització
          #map.bg-secondary.bg-opacity-10.rounded.border(style="height: 300px; display: flex; align-items: center; justify-content: center; color: #6c757d;")
            .text-center
              i.bi.bi-map.fs-1
              p (Aquí aniria el mapa)