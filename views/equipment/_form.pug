mixin equipmentForm(equipment, actionUrl, submitText, cancelUrl)
  form(action=actionUrl method="POST")
    .row.g-3
      .col-md-6
        label.form-label(for="nom") Nom *
        input.form-control(
          type="text"
          name="nom"
          required
          placeholder="Nom de l'equipament"
          value=(equipment && equipment.nom) || ''
        )
      .col-md-6
        label.form-label(for="tipus") Tipus *
        input.form-control(
          type="text"
          name="tipus"
          required
          placeholder="Biblioteca, Esportiu..."
          value=(equipment && equipment.tipus) || ''
        )
      .col-md-6
        label.form-label(for="localitzacio") Localització
        input.form-control(
          type="text"
          name="localitzacio"
          placeholder="PL DE LA FONT 1 BLQ: 0000 CP: 43003"
          value=(equipment && equipment.localitzacio) || ''
        )

      .col-md-6
        label.form-label(for="telefon") Telefon
        input.form-control(
          type="tel"
          name="telefon"
          placeholder="612345678"
          pattern="\\d{9}"
          inputmode="numeric"
          value=(equipment && equipment.telefon) || ''
        )
        small.form-text.text-muted Format: 9 digits sense espais
      .col-md-6
        label.form-label(for="horari") Horari
        input.form-control(
          type="text"
          name="horari"
          placeholder="De dilluns a divendres, de 9 a 14"
          value=(equipment && equipment.horari) || ''
        )
      .col-md-6
        label.form-label(for="nom_ens") Entitat *
        input.form-control(
          type="text"
          name="nom_ens"
          required
          placeholder="Entitat responsable"
          value=(equipment && equipment.nom_ens) || ''
        )
      .col-md-6
        label.form-label(for="codi_ens") Codi ens
        input.form-control(
          type="text"
          name="codi_ens"
          placeholder="1234567890"
          pattern="\\d{10}"
          inputmode="numeric"
          value=(equipment && equipment.codi_ens) || ''
        )
        small.form-text.text-muted Format: 10 digits
      .col-md-6
        label.form-label(for="latitud") Latitud
        input.form-control(
          type="number"
          name="latitud"
          step="any"
          min="-90"
          max="90"
          placeholder="41.118700"
          value=(equipment && equipment.latitud) || ''
        )
      .col-md-6
        label.form-label(for="longitud") Longitud
        input.form-control(
          type="number"
          name="longitud"
          step="any"
          min="-180"
          max="180"
          placeholder="1.244500"
          value=(equipment && equipment.longitud) || ''
        )
      .col-md-6
        label.form-label(for="municipal") Es municipal?
        select.form-select(name="municipal" required)
          option(value="" selected=(equipment == undefined)) Selecciona una opció
          option(value="true" selected=(equipment && equipment.municipal == true)) Sí
          option(value="false" selected=(equipment && equipment.municipal == false)) No

    .mt-4.d-flex.align-items-center
      button.btn.btn-primary.me-2(type="submit")
        i.bi.bi-save.me-1
        | #{submitText}
      a.btn.btn-secondary(href=cancelUrl)
        i.bi.bi-x-circle.me-1
        | Cancel·lar
